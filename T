    async def select_callback(self, interaction: discord.Interaction, select: discord.ui.Select):    
        option = select.values[0]    
        select.placeholder = f"Selecionado: {option.replace('_', ' ').title()}"    
            
        view = discord.ui.View()    
        is_active = self.settings[option]    
        btn_label = "Desativar" if is_active else "Ativar"    
        btn_style = discord.ButtonStyle.danger if is_active else discord.ButtonStyle.success    
        toggle_btn = discord.ui.Button(label=btn_label, style=btn_style)    
    
        async def toggle_callback(it: discord.Interaction):    
            self.settings[option] = not self.settings[option]    
            new_is_active = self.settings[option]    
            toggle_btn.label = "Desativar" if new_is_active else "Ativar"    
            toggle_btn.style = discord.ButtonStyle.danger if new_is_active else discord.ButtonStyle.success    
            await it.response.edit_message(embed=self.create_embed(option), view=view)    
    
        toggle_btn.callback = toggle_callback    
        view.add_item(toggle_btn)    
        await interaction.response.send_message(embed=self.create_embed(option), view=view, ephemeral=True)    
    
