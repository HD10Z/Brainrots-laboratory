    async def interaction_check(self, interaction: discord.Interaction) -> bool:    
        if interaction.user != self.user:    
            embed = discord.Embed(    
                title="Acesso Negado",    
                description="Você não pode mexer nos botões, apenas a pessoa que executou o comando. Se quiser mexer, você próprio execute.",    
                color=0xff0000    
            )    
            await interaction.response.send_message(embed=embed, ephemeral=True)    
            return False    
        return True    
    
