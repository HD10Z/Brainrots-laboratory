        status = self.settings[option_name]    
        label = option_name.replace('_', ' ').title()    
        color = 0x00ff00 if status else 0xff0000    
        embed = discord.Embed(    
            title="Ajuste de Proteção",    
            description=f"Opção: **{label}**\nStatus atual: **{'ATIVADO' if status else 'DESATIVADO'}**",    
            color=color    
        )    
        return embed    
    
