import string  
  
class ObfuscatorLogic:  
    @staticmethod  
    def minify(code):  
        # Remove comentários multi-linha e linha única  
        code = re.sub(r'--\[\[.*?\]\]', '', code, flags=re.DOTALL)  
        code = re.sub(r'--[^\n]*', '', code)  
        # Remove quebras de linha e espaços duplos para reduzir KB antes do HEX  
        code = re.sub(r'\s+', ' ', code).strip()  
        return code  
  
    @staticmethod  
    def pack_script(code):  
        # Primeiro minificamos para garantir o menor Hex possível  
        minified = ObfuscatorLogic.minify(code)  
        hex_encoded = minified.encode('utf-8').hex()  
          
        # Variáveis de 1 letra para economizar espaço  
        h = f"h{random.randint(1,9)}"  
        d = f"d{random.randint(1,9)}"  
          
        # Loader ultra-compacto sem espaços desnecessários  
        loader = f'local {h}="{hex_encoded}";local {d}={h}:gsub("..",function(c)return string.char(tonumber(c,16))end);return assert(loadstring or load)({d})()'  
        return loader    
    
    @staticmethod    
    def garbage_code(code):    
        # Lixo mais curto para não pesar no arquivo final  
        g = "local " + ",".join([f"v{i}" for i in range(5)]) + "=0;"  
        return g + code    
    
