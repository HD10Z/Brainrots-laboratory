    async def difficulty_callback(self, interaction: discord.Interaction, select: discord.ui.Select):    
        level = select.values[0]    
        for k in self.settings: self.settings[k] = False    
            
        if level == "leve":    
            self.settings["remover_comentarios"] = True    
            self.settings["compressor"] = True    
        elif level == "mediana":    
            self.settings["remover_comentarios"] = True    
            self.settings["bytecode_encoding"] = True    
        elif level == "dificil":    
            for k in ["remover_comentarios", "bytecode_encoding", "anti_tampering", "codigo_lixo"]:    
                self.settings[k] = True    
        elif level in ["impossivel", "extremo"]:    
            for k in self.settings: self.settings[k] = True    
                
        embed = discord.Embed(    
            title="⚙️ Dificuldade Alterada",    
            description=f"O nível de proteção foi definido como: **{level.upper()}**\n\n*Nota: As opções foram ativadas na tabela de status.*",    
            color=0x00ff00    
        )    
        await interaction.response.send_message(embed=embed, ephemeral=True)    
    
    @discord.ui.button(label="Start", style=discord.ButtonStyle.primary, row=4)    
    async def start_button(self, interaction: discord.Interaction, button: discord.ui.Button):    
          
        if not any(self.settings.values()):  
            embed_erro = discord.Embed(  
                title="⚠️ Nenhuma Opção Selecionada",  
                description="Você precisa ativar pelo menos uma opção de proteção ou escolher um Nível de Dificuldade antes de dar Start!",  
                color=0xff0000  
            )  
            return await interaction.response.send_message(embed=embed_erro, ephemeral=True)  
  
        await interaction.response.defer(ephemeral=True)    
        script = self.code_content    
  
        # Minifica SEMPRE antes de ofuscar para reduzir o tamanho do HEX  
        if any(self.settings.values()):  
            script = ObfuscatorLogic.minify(script)  
  
        if self.settings["anti_tampering"]:     
            script = "if not game:IsLoaded() then game.Loaded:Wait() end;" + script    
  
        if self.settings["bytecode_encoding"] or self.settings["string_encoding"] or self.settings["encryption_v3"] or self.settings["hex_strings"] or self.settings["embaralhar"] or self.settings["virtual_machine"]:    
            script = ObfuscatorLogic.pack_script(script)    
    
        if self.settings["codigo_lixo"]:     
            script = ObfuscatorLogic.garbage_code(script)    
    
        random_id = "".join([str(random.randint(0, 9)) for _ in range(10)])    
        filename = f"Obfuscator{random_id}script.txt"    
        file = discord.File(io.BytesIO(script.encode('utf-8')), filename=filename)    
            
        embed_res = discord.Embed(    
            title="✅ Obfuscação Segura Concluída",     
            description="Seu Mod Menu foi empacotado e otimizado. O tamanho foi reduzido através de minificação pré-hex.",     
            color=0x00ff00    
        )    
        await interaction.followup.send(embed=embed_res, file=file, ephemeral=True)  
  
class PaginacaoCastigo(discord.ui.View):  
    def __init__(self, data, user):  
        super().__init__(timeout=None)  
        self.d = data  
        self.u = user  
        self.p = 0  
        self.mp = max(0, (len(data) - 1) // 10)  
        self.ub()  
  
    def ub(self):  
        self.clear_items()  
        if self.p > 0:  
            bv = discord.ui.Button(label="<", style=discord.ButtonStyle.secondary)  
            bv.callback = self.b_voltar  
            self.add_item(bv)  
        if self.p < self.mp:  
            bi = discord.ui.Button(label=">", style=discord.ButtonStyle.secondary)  
            bi.callback = self.b_ir  
            self.add_item(bi)  
  
    def ge(self):  
        s = self.p * 10  
        c = self.d[s:s + 10]  
        desc = ""  
        n = discord.utils.utcnow()  
        for m in c:  
            t = m.timed_out_until - n  
            d = t.days  
            h, r = divmod(t.seconds, 3600)  
            mn, _ = divmod(r, 60)  
            ts = ""  
            if d > 0: ts += f"{d} dias "  
            if h > 0: ts += f"{h} horas "  
            if mn > 0: ts += f"{mn} minutos"  
            if not ts: ts = "Menos de 1 minuto"  
              
            tf = m.timed_out_until.strftime("%d/%m/%Y %H:%M")  
            desc += f"**{m.display_name}**\nCastigado até (Definido): {tf}\nTempo Restante: {ts.strip()}\n\n"  
        if not desc: desc = "Nenhum membro."  
        return discord.Embed(title=f"Membros de Castigo ({self.p + 1}/{self.mp + 1})", description=desc, color=0xff0000)  
  
    async def b_voltar(self, i: discord.Interaction):  
        if i.user != self.u: return  
        self.p -= 1  
        self.ub()  
        await i.response.edit_message(embed=self.ge(), view=self)  
  
    async def b_ir(self, i: discord.Interaction):  
        if i.user != self.u: return  
        self.p += 1  
        self.ub()  
        await i.response.edit_message(embed=self.ge(), view=self)  
  
class ObfuscatorBot(discord.Client):    
    def __init__(self):    
        intents = discord.Intents.default()  
        intents.members = True  
        super().__init__(intents=intents)    
        self.synced = False    
    
    async def on_ready(self):    
        await self.wait_until_ready()    
        if not self.synced:    
            await tree.sync()    
            self.synced = True    
        print(f"✅ {self.user} ON")    
    
bot = ObfuscatorBot()    
tree = app_commands.CommandTree(bot)    
    
@tree.command(name="obfuscator", description="Inicia o sistema de proteção de scripts")    
@app_commands.describe(start="Digite 'Start' para começar", file="Upload do arquivo .txt ou .lua", script="Cole o código neste lugar")    
async def obfuscate(interaction: discord.Interaction, start: str, file: discord.Attachment = None, script: str = None):    
    if start.lower() != "start":    
        return await interaction.response.send_message("Digite 'Start' para prosseguir.", ephemeral=True)    
    
    if not file and not script:    
        return await interaction.response.send_message("Envie um arquivo ou cole um script.", ephemeral=True)    
    
    code_content = (await file.read()).decode('utf-8', errors='ignore') if file else script    
    
    embed = discord.Embed(    
        title="🛡️ Script Protection System",    
        description="Gostaria de usar o obfuscator para os seus scriptes tiverem suas maiores proteções a roubo?",    
        color=0x5865f2    
    )    
        
    view = ConfigView(interaction.user, code_content)    
    await interaction.response.send_message(embed=embed, view=view)  
  
@tree.command(name="castigados", description="Lista todos os membros que estão mutados/de castigo.")  
async def castigados(interaction: discord.Interaction):  
    n = discord.utils.utcnow()  
    m = [x for x in interaction.guild.members if x.timed_out_until and x.timed_out_until > n]  
    if not m:  
        return await interaction.response.send_message(embed=discord.Embed(description="Nenhum membro está de castigo no momento.", color=0x00ff00), ephemeral=True)  
    v = PaginacaoCastigo(m, interaction.user)  
    await interaction.response.send_message(embed=v.ge(), view=v, ephemeral=True)  
    
